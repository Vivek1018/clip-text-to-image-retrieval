# Hugging Face (optional — raises rate limits for model downloads)
HF_TOKEN=

# CLIP model (Hugging Face model id)
CLIP_MODEL_ID=openai/clip-vit-base-patch32

# Paths (relative to repository root unless absolute)
IMAGES_DIR=data/images
EMBEDDINGS_DIR=data/embeddings
EMBEDDINGS_MANIFEST=data/embeddings/manifest.json

# Indexing
BATCH_SIZE=20
IMAGE_GLOB=*.jpg

# Retrieval defaults
TOP_K=6
IMAGE_ROTATE_DEGREES=-90

# Device: auto | cpu | cuda
DEVICE=auto
